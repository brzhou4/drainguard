# Copy to .env and change the random part. ntfy topics are public to anyone who knows the name.
CITY_TOPIC=drainguard-city-changeme
APP_URL=http://localhost:8501

# Momen drain-routing webhook (server-side only; anyone with the URL can call it)
DRAIN_WEBHOOK_URL=
# Optional: keep volunteers and drain checks across restarts (see docs/supabase_schema.sql).
SUPABASE_URL=
SUPABASE_KEY=
# A check counts for this many days, then the drain goes back to Not checked.
CHECK_TTL_DAYS=7
# Demo only: force the storm level (storm, watch or clear). Leave empty for the real forecast.
STORM_OVERRIDE=
